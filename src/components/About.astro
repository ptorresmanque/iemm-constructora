---
interface Props {
  eyebrow: string;
  title: string;
  p1: string;
  p2: string;
  badgeNumber: string;
  badgeText: string;
  list: string[];
}

const { eyebrow, title, p1, p2, badgeNumber, badgeText, list } = Astro.props;
---

<section id="about" class="py-20 md:py-24 bg-[var(--color-surface)]">
  <div class="container-max px-4 md:px-10">
    <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
      <div class="relative group">
        <div class="absolute -top-4 -left-4 w-24 h-24 border-t-4 border-l-4 border-[var(--color-secondary)]" aria-hidden="true"></div>
        <div class="aspect-[4/5] bg-cover bg-center overflow-hidden rounded">
          <img
            src="/images/about-team.jpg"
            alt="Professional construction management team reviewing blueprints in a modern office."
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        </div>
        <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 bg-[var(--color-primary)] p-6 sm:p-8 text-white max-w-xs">
          <span class="block text-4xl sm:text-5xl font-extrabold text-[var(--color-secondary)] mb-2 font-[var(--font-display)]">
            {badgeNumber}
          </span>
          <span class="block text-[10px] sm:text-xs font-bold uppercase tracking-widest leading-snug">
            {badgeText}
          </span>
        </div>
      </div>

      <div>
        <h2 class="font-[var(--font-display)] text-2xl md:text-3xl font-bold text-[var(--color-primary)] mb-8 flex items-center gap-4 uppercase">
          <span class="w-12 h-[2px] bg-[var(--color-secondary)]" aria-hidden="true"></span>
          {eyebrow}
        </h2>
        <h3 class="font-[var(--font-display)] text-3xl md:text-4xl font-bold text-[var(--color-on-surface)] mb-6 leading-tight text-balance">
          {title}
        </h3>
        <p class="text-base sm:text-lg text-[var(--color-on-surface-variant)] mb-6 leading-relaxed text-pretty">
          {p1}
        </p>
        <p class="text-sm sm:text-base text-[var(--color-on-surface-variant)] mb-8 leading-relaxed">
          {p2}
        </p>
        <ul class="space-y-4">
          {list.map((item) => (
            <li class="flex items-center gap-3">
              <span class="material-symbols-outlined filled text-[var(--color-primary)]">check_circle</span>
              <span class="text-xs sm:text-sm font-bold text-[var(--color-primary)] uppercase tracking-wide">
                {item}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
